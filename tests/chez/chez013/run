. ../../testutils.sh

case $(uname -s) in
    OpenBSD | FreeBSD | NetBSD)
        MAKE=gmake
        ;;

    *)
        MAKE=make
        ;;
esac

${MAKE} all > /dev/null

# Sort output: C printf and Chez Scheme IO use independent stdio buffers
# that can flush in non-deterministic order on Windows.
run Struct.idr | safesort

${MAKE} clean > /dev/null
