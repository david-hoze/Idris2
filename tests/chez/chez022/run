. ../../testutils.sh

case $(uname -s) in
    OpenBSD | FreeBSD | NetBSD)
        MAKE=gmake
        ;;

    *)
        MAKE=make
        ;;
esac

${MAKE} all > /dev/null

# Sort output: GC finalizer ordering between Scheme callbacks and C
# free functions is non-deterministic across platforms.
run usealloc.idr | safesort

. ../../testutils.sh
${MAKE} clean > /dev/null
